{% macro render_section_content(label, span) %}
    <section class="content">
        <label>{{label}}</label>
        <span>{{span}}</span>
    </section>
{% endmacro %}
{% macro render_section(section_class, ds, layout, zip, fmt) %}
    <section class="{{section_class}}">
        {% for data, field in zip(ds.items(), layout) %}
            {{render_section_content(field.label, fmt(ds[field.name], field.format_mask))}}
        {% endfor %}
    </section>
{% endmacro %}
{% macro render_group_header(ds, layout, zip, fmt, nivel) %}
    {{render_section("group-header-%i" % nivel, ds, layout, zip, fmt)}}
{% endmacro %}
{% macro render_group_footer(ds, layout, zip, fmt, nivel) %}
    {{render_section("group-footer-%i" % nivel, ds, layout, zip, fmt)}}
{% endmacro %}
{% macro render_detail(ds, layout, zip, fmt) %}
    <table class="relatorio">
        <thead>
            <tr>
                {% for field in layout %}
                    <th style="text-align: {{field.alignment}}">{{field.label}}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for dt_item in ds %}
                <tr>
                    {% for field in layout %}
                        <td style="text-align: {{field.alignment}}"><p>{{fmt(dt_item[field.name], field.format_mask)}}</p></td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}
{% macro render_group(ds, layout, zip, fmt, nivel) %}
    {% for data in ds %}
        {% if data.fields and layout.header %}
            {{render_group_header(data.fields, layout.header, zip, fmt, nivel)}}
        {% endif %}
        {% if data.groups and layout.groups %}
            {{render_group(data.groups, layout.groups, zip, fmt, nivel + 1)}}
        {% endif %}
        {% if data.detail and layout.detail %}
            {{render_detail(data.detail, layout.detail, zip, fmt)}}
        {% endif %}
        {% if data.fields and layout.footer %}
            {{render_group_footer(data.fields, layout.footer, zip, fmt, nivel)}}
        {% endif %}
        {% if not loop.last and nivel == 0 %}
            {{render_divisor()}}
        {% endif %}
    {% endfor %}
{% endmacro %}
{% macro render_divisor() %}
    <hr class="divisor-table"/>
{% endmacro %}
{% macro render_summary(ds, layout, zip, fmt) %}
    <section class="summary">
        {% for field in layout %}
            {{render_section_content(field.label, fmt(ds[field.name], field.format_mask))}}
        {% endfor %}
    </section>
{% endmacro %}