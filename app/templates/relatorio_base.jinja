        </svg>
        <h1>Isis Report</h1>
    </div>
    <hr class="divisor"/>
    <div class="header-table">
        <h2>{% block titulo %} {% endblock %}</h2>
        <div class="periodo">
            <h3>{% block filters %} {% endblock %}</h3>
        </div>
    </div>
    {% block conteudo %} {% endblock %}
    {% if type != "pdf" %}
        <div class="table-footer">
            <div class="data">
                <span>{% block data_hora_impresssao %} {% endblock %}</span>
            </div>
        </div>
    {% endif %}
</main>
</body>
</html>