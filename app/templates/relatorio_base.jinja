<!DOCTYPE html>
<html>
<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
    <title>Isis Report</title>
    <style>
        :root {
            --cor-client: #0A2F46;
            --light-strips: #f2f2f2;
            --light-white: #f1f1f1;
            --contraste-cabecalho: #f1f1f1;
            --font-customizada: sans-serif, Arial, Helvetica;
            /* Orientação para impressão: auto || portrait || landscape */
            --orientacao: portrait;
            --margem-impressao: .25in .2in;
        }

        * {
            -webkit-print-color-adjust: {% block mode %} {% endblock %};
        }

        body {
          font-family: var(--font-customizada, sans-serif);
          margin: 0;
          padding: 0;
          color: #3b4151;
        }

        .container {
          margin: 0 3rem 0;
          padding: 1.2rem;
        }

        h1 {
            color: #333;
            font-family: var(--font-customizada, sans-serif);
            font-size: 1.8rem;
            margin-bottom: 0;
            margin-top: 0;
            padding-inline: .5rem;
        }

        h2 {
            font-family: var(--font-customizada, sans-serif);
            font-size: 1.3rem;
        }

        h3 {
            font-family: var(--font-customizada, sans-serif);
            font-size: .9rem;
            font-weight: 300;
        }

        .icon-area {
            display: flex;
            align-items: center;
        }

        .icon-area svg, .icon-area img{
            width: 64px;
            height: 64px;
            padding-inline: .5rem;
        }

        p, th, td {
          font-family: var(--font-customizada, sans-serif);
          font-size: 14px;
        }

        p {
            padding-inline: .45rem;
            margin-block: .5em;
        }

        .relatorio {
            margin-block: .5rem;
            border: 1px solid var(--light-white, #f1f1f1);
            border-radius: 6px;
            width: 100%;
            border-spacing: 0;
        }

        .header-table {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-inline: .5rem;
        }

        .header-table h2 {
            font-weight: 600;
            text-align: center;
        }

        .periodo h3 {
            text-align: center;
        }

        .relatorio thead th:first-child {
            border-radius: 4px 0 0 0;
        }

        .relatorio thead th:last-child {
            border-radius: 0 4px 0 0;
        }

        .relatorio thead th {
            background-color: var(--cor-client, #0A2F46);
            padding: .9rem;
            color: var(--contraste-cabecalho ,#f1f1f1);
        }

        .relatorio tbody tr:nth-child(even) {
            background-color: var(--light-strips, #f2f2f2);
        }

        td {
            border-bottom: 1px solid var(--light-white, #f1f1f1);
        }

        .table-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .5rem 1rem;
            background-color: #fff;
            margin-top: 1rem;
        }

        .table-footer svg {
            width: 7rem;
        }

        .table-footer .data {
            font-size: .8rem;
        }

        .group-header-0, .group-footer-0,
        .group-header-1, .group-footer-1, .summary {
            padding: 0.5rem 1rem;
            border-radius: 4px;
            display: flex;
            flex-wrap: wrap;
        }

        .group-header-0, .group-footer-0, .summary {
            background-color: var(--contraste-cabecalho, #f1f1f1);
        }

        .summary {
            border: 1px solid #d1d1d1;
        }

        .group-header-1, .group-footer-1 {
            border: 1px solid var(--contraste-cabecalho, #f1f1f1);
            margin-block: .5rem;
        }

        .group-header-1 .content, .group-footer-1 .content,
        .group-header-0 .content, .group-footer-0 .content,
        .summary .content {
            padding-block: 0.2rem;
            margin-inline-end: 1rem;
        }

        .group-header-0 .content label, .group-footer-0 .content label,
        .group-header-1 .content label, .group-footer-1 .content label,
        .summary .content label {
            font-weight: 300;
            font-size: 0.9rem;
        }


        .group-header-0 .content span, .group-footer-0 .content span,
        .group-header-1 .content span, .group-footer-1 .content span,
        .summary span {
            font-weight: 600;
            font-size: 1rem;
        }

        .divisor-table {
            margin-block-end: 1rem;
        }
    </style>
</head>
<body>
<main class="container">
    <div class="icon-area">
        <img src="data:image/png;base64," alt="Isis Report">
        <h1>Isis Report</h1>
    </div>
    <hr class="divisor"/>
    <div class="header-table">
        <h2>{% block titulo %} {% endblock %}</h2>
        <div class="periodo">
            <h3>{% block filters %} {% endblock %}</h3>
        </div>
    </div>
    {% block conteudo %} {% endblock %}
    {% if type != "pdf" %}
        <div class="table-footer">
            <div class="data">
                <span>{% block data_hora_impresssao %} {% endblock %}</span>
            </div>
        </div>
    {% endif %}
</main>
</body>
</html>