{
    "files.encoding": "utf8",
    "editor.detectIndentation": false,
    "[python]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[json]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "python.analysis.extraPaths": [
        "${workspaceFolder}/app"
    ],
    "pylint.args": [
        "--max-line-length=140",
        "--init-hook=import sys; from pathlib import Path; sys.path.insert(0, str(Path.cwd() / 'app'))"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.typeCheckingMode": "off",
    "files.exclude": {
        "**/.git": true,
        "**/__pycache__": true,
        "**/.venv": false
    }
}