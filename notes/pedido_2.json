{
    "meta": {
        "company": "Minha Empresa",
        "title": "Pedido de Vendas",
        "sub_title": "De 01/01/2024 até 31/12/2024",
        "type": "pdf",
        "mode": "exact"
    },
    "sections": [
        {
            "data_source": {
                "alias": "data_entrega_empresas",
                "query": "SELECT data_entrega, id_cliente, empresa FROM pedidos GROUP BY data_entrega, id_cliente, empresa",
                "sub_queries": [
                    {
                        "alias": "pedidos",
                        "query": "SELECT id_pedido_venda, data_pedido, nome_produto FROM pedidos WHERE id_cliente = :id_cliente AND data_entrega = :data_entrega",
                        "filters": {
                            "id_cliente": "id_cliente",
                            "data_entrega": "data_entrega"
                        },
                        "sub_queries": [
                            {
                                "alias": "cargas",
                                "query": "SELECT qtde, valor_unitario, valor_total FROM cargas WHERE id_pedido_venda = :id_pedido_venda",
                                "filters": {
                                    "id_pedido_venda": "id_pedido_venda"
                                }
                            },
                            {
                                "alias": "tarifas",
                                "query": "SELECT qtde, valor_unitario, valor_total FROM tarifas WHERE id_pedido_venda = :id_pedido_venda",
                                "filters": {
                                    "id_pedido_venda": "id_pedido_venda"
                                }
                            }
                        ]
                    }
                ],
                "summary": {
                    "valor_total": "data_entrega_empresas.cargas.valor_total",
                    "total_tarifa": "data_entrega_empresas.tarifas.valor_total"
                }
            },
            "layout": {
                "groups": {
                    "header": [
                        {
                            "field": "data_entrega_empresas.empresa",
                            "label": "Empresa"
                        },
                        {
                            "field": "data_entrega_empresas.data_entrega",
                            "label": "Data Entrega",
                            "format_mask": "date"
                        }
                    ],
                    "groups": {
                        "header": [
                            {
                                "field": "pedidos.pedido",
                                "label": "Nro Pedido"
                            },
                            {
                                "field": "pedidos.data_pedido",
                                "label": "Data Pedido",
                                "format_mask": "date"
                            },
                            {
                                "field": "pedidos.nome_produto",
                                "label": "Produto"
                            },
                            {
                                "field": "pedidos.total_tarifa",
                                "label": "Total Tarifa",
                                "format_mask": "float"
                            }
                        ],
                        "detail": [
                            [
                                {
                                    "field": "cargas.qtde",
                                    "label": "Quantidade",
                                    "format_mask": "int",
                                    "alignment": "right"
                                },
                                {
                                    "field": "cargas.valor_unitario",
                                    "label": "Valor Unitário",
                                    "format_mask": "float",
                                    "alignment": "right"
                                },
                                {
                                    "field": "cargas.valor_total",
                                    "label": "Valor Total",
                                    "format_mask": "float",
                                    "alignment": "right"
                                }
                            ],
                            [
                                {
                                    "field": "tarifas.qtde",
                                    "label": "Quantidade",
                                    "format_mask": "int",
                                    "alignment": "right"
                                },
                                {
                                    "field": "tarifas.valor_unitario",
                                    "label": "Valor Unitário",
                                    "format_mask": "float",
                                    "alignment": "right"
                                },
                                {
                                    "field": "tarifas.valor_total",
                                    "label": "Valor Total",
                                    "format_mask": "float",
                                    "alignment": "right"
                                }
                            ]
                        ],
                        "footer": [
                            {
