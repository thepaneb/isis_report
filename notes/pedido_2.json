                            "label": "Valor Total",
                            "format_mask": "float"
                        }
                    ]
                },
                "summary": [
                    {
                        "field": "qtde",
                        "label": "Quantidade",
                        "format_mask": "int"
                    },
                    {
                        "field": "valor_total",
                        "label": "Valor Total",
